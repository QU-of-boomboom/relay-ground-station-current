cell(MMCME2_ADV) {
 pin(CLKFBIN) {
   direction : input;
   clock : true;
   timing() {
     timing_type : minimum_period;
     related_pin : "CLKFBIN";
   }
 }
 pin(CLKFBOUT) {
   direction : output;
   function : "(CLKINSEL & CLKIN1) + (!CLKINSEL & CLKIN2)";
   timing() {
     timing_type : combinational;
     timing_sense : positive_unate;
     related_pin : "CLKIN1 CLKIN2";
     fpga_arc_condition : "mmcme2_adv.COMPENSATION_ZHOLD";
   }
   timing() {
     timing_type : combinational;
     timing_sense : positive_unate;
     related_pin : "CLKIN1 CLKIN2";
     fpga_arc_condition : "mmcme2_adv.COMPENSATION_INTERNAL";
   }
   timing() {
     timing_type : combinational;
     timing_sense : positive_unate;
     related_pin : "CLKIN1 CLKIN2";
     fpga_arc_condition : "mmcme2_adv.COMPENSATION_EXTERNAL";
