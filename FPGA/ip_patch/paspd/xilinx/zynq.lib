cell(LDCE) {
 latch ("IQ", "IQN") {
    clear : "CLR";
    enable : "GE&G";
    data_in : "D";
 }
 pin(CLR) {
   direction : input;
   timing() {
     timing_type : recovery_falling;
     related_pin : "G";
   }
   timing() {
     timing_type : removal_falling;
     related_pin : "G";
   }
   timing() {
     timing_type : min_pulse_width;
     related_pin : "CLR";
   }
 }
 pin(D) {
   direction : input;
   timing() {
     timing_type : setup_falling;
     related_pin : "G";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "G";
   }
 }
 pin(G) {
   direction : input;
   clock : true;
   timing() {
     timing_type : min_pulse_width;
     related_pin : "G";
   }
 }
 pin(GE) {
   direction : input;
   timing() {
     timing_type : setup_falling;
     related_pin : "G";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "G";
   }
 }
 pin(Q) {
   direction : output;
   timing() {
     timing_type : combinational;
     related_pin : "D GE";
   }
   timing() {
     timing_type : rising_edge;
     related_pin : "G";
   }
   timing() {
     timing_type : clear;
     timing_sense : negative_unate;
     related_pin : "CLR";
   }
 }
}

cell(LDPE) {
