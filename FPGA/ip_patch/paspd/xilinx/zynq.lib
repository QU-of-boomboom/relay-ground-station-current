 fpga_condition(iddr) {
   fpga_condition_value(DDR_CLK_EDGE_OPPOSITE_EDGE) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'OPPOSITE_EDGE'"
   }
   fpga_condition_value(DDR_CLK_EDGE_OPPOSITE_EDGE_SRTYPE_ASYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'OPPOSITE_EDGE' && SRTYPE == 'ASYNC'"
   }
   fpga_condition_value(DDR_CLK_EDGE_OPPOSITE_EDGE_SRTYPE_SYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'OPPOSITE_EDGE' && SRTYPE == 'SYNC'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE_PIPELINED) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE_PIPELINED'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE_PIPELINED_SRTYPE_ASYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE_PIPELINED' && SRTYPE == 'ASYNC'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE_PIPELINED_SRTYPE_SYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE_PIPELINED' && SRTYPE == 'SYNC'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE_SRTYPE_ASYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE' && SRTYPE == 'ASYNC'"
   }
   fpga_condition_value(DDR_CLK_EDGE_SAME_EDGE_SRTYPE_SYNC) {
     fpga_arc_condition : "DDR_CLK_EDGE == 'SAME_EDGE' && SRTYPE == 'SYNC'"
   }
   fpga_condition_value(SRTYPE_ASYNC) {
     fpga_arc_condition : "SRTYPE == 'ASYNC'"
   }
 }
}

