   fpga_condition_value(CLKOUT4_CASCADE_FALSE_COMPENSATION_BUF_IN) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'FALSE' && COMPENSATION == 'BUF_IN'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_FALSE_COMPENSATION_EXTERNAL) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'FALSE' && COMPENSATION == 'EXTERNAL'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_FALSE_COMPENSATION_INTERNAL) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'FALSE' && COMPENSATION == 'INTERNAL'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_FALSE_COMPENSATION_ZHOLD) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'FALSE' && COMPENSATION == 'ZHOLD'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_TRUE_COMPENSATION_BUF_IN) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'TRUE' && COMPENSATION == 'BUF_IN'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_TRUE_COMPENSATION_EXTERNAL) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'TRUE' && COMPENSATION == 'EXTERNAL'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_TRUE_COMPENSATION_INTERNAL) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'TRUE' && COMPENSATION == 'INTERNAL'"
   }
   fpga_condition_value(CLKOUT4_CASCADE_TRUE_COMPENSATION_ZHOLD) {
     fpga_arc_condition : "CLKOUT4_CASCADE == 'TRUE' && COMPENSATION == 'ZHOLD'"
   }
   fpga_condition_value(COMPENSATION_BUF_IN) {
     fpga_arc_condition : "COMPENSATION == 'BUF_IN'"
   }
   fpga_condition_value(COMPENSATION_EXTERNAL) {
     fpga_arc_condition : "COMPENSATION == 'EXTERNAL'"
   }
   fpga_condition_value(COMPENSATION_INTERNAL) {
     fpga_arc_condition : "COMPENSATION == 'INTERNAL'"
   }
   fpga_condition_value(COMPENSATION_ZHOLD) {
     fpga_arc_condition : "COMPENSATION == 'ZHOLD'"
   }
 }
}

