}

cell(BUFGCE) {
 pin(CE) {
   direction : input;
   timing() {
     timing_type : setup_rising;
     related_pin : "I";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "I";
   }
 }
 pin(I) {
   direction : input;
   clock : true;
   timing() {
     timing_type : minimum_period;
     related_pin : "I";
   }
 }
 pin(O) {
   direction : output;
   function : "CE & I";
   timing() {
     timing_type : combinational;
     timing_sense : positive_unate;
     related_pin : "I";
   }
 }
}

cell(BUFGCTRL) {
 pin(CE0) {
   direction : input;
   timing() {
     timing_type : setup_falling;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : setup_rising;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 pin(CE1) {
   direction : input;
   timing() {
     timing_type : setup_falling;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : setup_rising;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 pin(I0) {
   direction : input;
   clock : true;
   timing() {
     timing_type : minimum_period;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : minimum_period;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 pin(I1) {
   direction : input;
   clock : true;
   timing() {
     timing_type : minimum_period;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : minimum_period;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 pin(IGNORE0) {
   direction : input;
 }
 pin(IGNORE1) {
   direction : input;
 }
 pin(O) {
   direction : output;
   function : "(CE0 & I0 & S0) + (CE1 & I1 & S1)";
   timing() {
     timing_type : combinational;
     timing_sense : positive_unate;
     related_pin : "I0 I1";
   }
 }
 pin(S0) {
   direction : input;
   timing() {
     timing_type : setup_rising;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : setup_falling;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "I0";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 pin(S1) {
   direction : input;
   timing() {
     timing_type : setup_rising;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_1";
   }
   timing() {
     timing_type : setup_falling;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
   timing() {
     timing_type : hold_falling;
     related_pin : "I1";
     fpga_arc_condition : "bufgctrl.INIT_OUT_0";
   }
 }
 fpga_condition(bufgctrl) {
   fpga_condition_value(INIT_OUT_0) {
     fpga_arc_condition : "INIT_OUT == '0'"
   }
   fpga_condition_value(INIT_OUT_1) {
     fpga_arc_condition : "INIT_OUT == '1'"
   }
 }
}

