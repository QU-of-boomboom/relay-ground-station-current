cell(FDCE) {
 ff ("IQ","IQN"){
   clocked_on : "C";
   clear : "CLR";
   next_state : "(CE&D) | (!CE&IQ)";
 }
 pin(C) {
   direction : input;
   clock : true;
   timing() {
     timing_type : minimum_period;
     related_pin : "C";
   }
   timing() {
     timing_type : min_pulse_width;
     related_pin : "C";
   }
 }
 pin(CE) {
   direction : input;
   timing() {
     timing_type : setup_rising;
     related_pin : "C";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "C";
   }
 }
 pin(CLR) {
   direction : input;
   timing() {
     timing_type : recovery_rising;
     related_pin : "C";
   }
   timing() {
     timing_type : removal_rising;
     related_pin : "C";
   }
   timing() {
     timing_type : min_pulse_width;
     related_pin : "CLR";
   }
 }
 pin(D) {
   direction : input;
   timing() {
     timing_type : setup_rising;
     related_pin : "C";
   }
   timing() {
     timing_type : hold_rising;
     related_pin : "C";
   }
 }
 pin(Q) {
   direction : output;
   timing() {
     timing_type : rising_edge;
     related_pin : "C";
   }
   timing() {
     timing_type : clear;
     timing_sense : negative_unate;
     related_pin : "CLR";
   }
 }
}

